{
  "name": "dsh-workspace-virtual-groups",
  "version": "0.1.0",
  "description": "Virtual workspace groups for the DSH web sidebar: a built-in default group, group create/rename/delete, drag-and-drop project grouping and ordering.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh-plugin",
    "plugin",
    "sidebar",
    "workspace",
    "workspace-groups",
    "client-plugin"
  ],
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    },
    "manifestVersion": 1
  },
  "scripts": {
    "build": "node scripts/build-host.mjs && node scripts/build-client.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "vitest": "3.2.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
